FROM node:20-alpine

WORKDIR /app

# تثبيت متصفح Chromium ومكتبات الخطوط لتوليد كشوف المرتبات PDF بدقة
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont

ENV CHROME_BIN=/usr/bin/chromium-browser
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# نسخ وتثبيت الحزم الأساسية
COPY package.json ./
RUN npm install --omit=dev --no-audit

# نسخ الكود
COPY server/ ./server/

EXPOSE 3100

ENV NODE_ENV=production
ENV PORT=3100
ENV WA_AUTH_PATH=/app/server/whatsapp-auth

CMD ["node", "server/whatsapp-server.js"]
