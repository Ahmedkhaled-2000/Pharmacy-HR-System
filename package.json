{
  "name": "pharmacy-hr-system",
  "productName": "منظومة الموارد البشرية",
  "version": "1.0.1",
  "description": "منظومة إدارة الموارد البشرية والرواتب - تطبيق ويندوز المكتبي",
  "author": "Pharmacy HR Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "node server/hr-backend.js",
    "start-gui": "start WhatsApp-Server-Control.hta",
    "whatsapp-manager": "wscript whatsapp-manager.vbs",
    "whatsapp-server": "node server/whatsapp-server.js",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:electron": "cross-env ELECTRON=true node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build:electron && electron-builder --win",
    "build:exe": "npm run build:electron && electron-builder --win",
    "generate-ico": "node scripts/generate-ico.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "face-api.js": "^0.22.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.38.0",
    "onnxruntime-web": "^1.29.0",
    "oxlint": "^1.80.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "png-to-ico": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0",
    "workbox-window": "^7.4.1"
  }
}
