{
  "appId": "com.pharmacy.hr.system",
  "productName": "منظومة الموارد البشرية",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "server/**/*",
    "node_modules/@whiskeysockets/**/*",
    "node_modules/qrcode/**/*",
    "node_modules/express/**/*",
    "node_modules/cors/**/*",
    "node_modules/pino/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "${name}-Setup-${version}.${ext}",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "منظومة إدارة الموارد البشرية والرواتب",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "language": "1025"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Ahmedkhaled-2000",
      "repo": "Pharmacy-HR-System"
    }
  ]
}
